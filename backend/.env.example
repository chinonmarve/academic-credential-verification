PORT=5000
JWT_SECRET=change_this_secret_in_production

# PUBLIC_BASE_URL controls what URL the generated QR codes point to.
# - Local development: leave blank. It falls back to http://localhost:PORT.
# - Live deployment: set this to your actual public URL, e.g.
#   PUBLIC_BASE_URL=https://your-domain.com
#   (no trailing slash). Every QR code generated after that will encode
#   https://your-domain.com/verify?id=... instead of localhost, so phones
#   scanning the certificate QR with their normal camera app land on the
#   real public verification page.
PUBLIC_BASE_URL=
# NOTE ON DATABASE:
# The research specifies MongoDB Atlas for operational data. This prototype ships
# with a zero-config embedded JSON data store (src/data/db.json) via db.js so the
# project runs immediately without external services. To use real MongoDB Atlas,
# set MONGODB_URI below and swap src/db.js for a Mongoose-backed implementation
# (the service layer in src/services/* is already isolated for this purpose).
MONGODB_URI=

# Simulated Ethereum-compatible network label shown in the UI (see BlockchainService)
BLOCKCHAIN_NETWORK_LABEL=Simulated Ethereum-Compatible Network
